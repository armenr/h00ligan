<!-- Adapted from cargo-about's MIT OR Apache-2.0 example template. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>h00ligan third-party licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.45; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
    pre { border: 1px solid #aaa; max-height: 22rem; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>h00ligan third-party licenses</h1>
  <p>Generated from the locked one-file product dependency graph.</p>
  <h2>License overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  <h2>License texts and users</h2>
  {{#each licenses}}
    {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
    <h4>{{name}}</h4>
    <ul>
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
