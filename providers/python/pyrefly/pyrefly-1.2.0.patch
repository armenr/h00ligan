+pub fn h00_semantic_facts(transaction: &Transaction, handle: &Handle) -> H00SemanticFacts {
+    let ast = &*transaction.get_ast(handle).unwrap();
+    let mut glean_state = GleanState::new(transaction, handle);
+    glean_state.record_name("".to_owned());
+    glean_state.generate_facts(&ast.body, ast.range());
+
+    let facts = glean_state.facts;
+    let references = facts
+        .xrefs
+        .into_iter()
+        .map(|xref| H00ReferenceFact {
+            target_name: *xref.target.name.key,
+            target_file: xref.target.file.map(|file| *file.key),
+            source_span: (&xref.source).into(),
+        })
+        .collect();
+    H00SemanticFacts {
+        file: *facts.file.key,
+        declarations: facts.h00_declarations,
+        references,
+    }
+}
+
