[package]
name = "h00ligan-product"
version = "@H00LIGAN_VERSION@"
edition = "2024"
license = "MIT OR Apache-2.0"
publish = false

[workspace]
resolver = "3"

[[bin]]
name = "h00ligan"
path = "src/main.rs"

[dependencies]
h00ligan = { path = "@H00_LIGAN_PATH@" }
h00ligan-ra-provider = { path = "@H00_RA_PROVIDER_PATH@" }
h00ligan-provider-protocol = { path = "../source/crates/h00ligan-provider-protocol" }
