+fn index_exact_file_tokens(
+    analysis: &Analysis,
+    token_store: &ConcurrentTokenStore,
+    def_map: &DashMap<Definition, TokenId>,
+    file_id: FileId,
+) -> Option<StaticIndexedFileTokens> {
+    let db = &analysis.db;
+    let current_crate = crates_for(db, file_id).pop().map(Into::into);
+    let sema = hir::Semantics::new(db);
+    let root = sema.parse_guess_edition(file_id).syntax().clone();
+    let edition = sema.attach_first_edition(file_id).edition(sema.db);
+    let display_target = sema.first_crate(file_id)?.to_display_target(sema.db);
+    let tokens = root.descendants_with_tokens().filter_map(|it| match it {
+        syntax::NodeOrToken::Node(_) => None,
+        syntax::NodeOrToken::Token(it) => Some(it),
+    });
+    let mut result = StaticIndexedFileTokens { file_id, tokens: vec![] };
+
+    let mut add_token = |def: Definition, range: TextRange, scope_node: &SyntaxNode| {
+        let id = *def_map.entry(def).or_insert_with(|| {
+            // Exact SCIP tokens are shared across the entire admitted file
+            // population, so their payload must describe the definition
+            // itself rather than whichever reference wins a worker race.
+            let token_crate = def.krate(db).or(current_crate);
+            let token_edition = token_crate.map(|krate| krate.edition(db)).unwrap_or(edition);
+            let token_display_target =
+                token_crate.map(|krate| krate.to_display_target(db)).unwrap_or(display_target);
+            token_store.insert(TokenStaticData {
+                documentation: documentation_for_definition(&sema, def, scope_node),
+                // Hover is a browser concern and is not consumed by SCIP
+                // emission. Omitting it avoids an expensive semantic query
+                // per exact-export definition.
+                hover: None,
+                definition: def
+                    .try_to_nav(&sema)
+                    .map(UpmappingResult::call_site)
+                    .map(|it| FileRange { file_id: it.file_id, range: it.focus_or_full_range() }),
+                definition_body: def
+                    .try_to_nav(&sema)
+                    .map(UpmappingResult::call_site)
+                    .map(|it| FileRange { file_id: it.file_id, range: it.full_range }),
+                references: vec![],
+                moniker: token_crate.and_then(|krate| def_to_moniker(db, def, krate)),
+                display_name: def.name(db).map(|name| name.display(db, token_edition).to_string()),
+                signature: Some(def.label(db, token_display_target)),
+                kind: def_to_kind(db, def),
+            })
+        });
+        let mut token = token_store.get_mut(id).unwrap();
+        token.references.push(ReferenceData {
+            range: FileRange { range, file_id },
+            is_definition: match def.try_to_nav(&sema).map(UpmappingResult::call_site) {
+                Some(it) => it.file_id == file_id && it.focus_or_full_range() == range,
+                None => false,
+            },
+        });
+        result.tokens.push((range, id));
+    };
+
+    if let Some(module) = sema.file_to_module_def(file_id) {
+        add_token(Definition::Module(module), root.text_range(), &root);
+    }
+    for token in tokens {
+        let range = token.text_range();
+        let node = token.parent().unwrap();
+        if let Some(defs) = hir::attach_db(db, || get_definitions(&sema, token.clone())) {
+            for (def, _) in defs {
+                add_token(def, range, &node);
+            }
+        }
+    }
+    Some(result)
+}
+
+fn compute_exact_file_population<'a>(
+    analysis: &'a Analysis,
+    files_to_index: Vec<FileId>,
+    requested_threads: usize,
+) -> StaticIndex<'a> {
+    let mut visited_files = FxHashSet::default();
+    let files_to_index = files_to_index
+        .into_iter()
+        .filter(|file_id| visited_files.insert(*file_id))
+        .collect::<Vec<_>>();
+    if files_to_index.is_empty() {
+        return StaticIndex {
+            files: Vec::new(),
+            tokens: TokenStore::default(),
+            analysis,
+            db: &analysis.db,
+            def_map: FxHashMap::default(),
+            #[cfg(test)]
+            worker_threads: 0,
+        };
+    }
+    let num_threads = requested_threads.max(1).min(files_to_index.len());
+    let mut analyses = (0..num_threads).map(|_| analysis.clone()).collect::<Vec<_>>();
+    let def_map = DashMap::default();
+    let concurrent_tokens = ConcurrentTokenStore::default();
+    let mut indexed_files = std::thread::scope(|scope| {
+        let threads = analyses
+            .iter_mut()
+            .enumerate()
+            .map(|(thread_index, analysis)| {
+                let work = files_to_index
+                    .iter()
+                    .copied()
+                    .enumerate()
+                    .filter(move |(index, _)| index % num_threads == thread_index);
+                let def_map = &def_map;
+                let tokens = &concurrent_tokens;
+                scope.spawn(move || {
+                    hir::attach_db(&analysis.db, || {
+                        work.filter_map(|(_, file_id)| {
+                            index_exact_file_tokens(analysis, tokens, def_map, file_id)
+                        })
+                        .collect::<Vec<_>>()
+                    })
+                })
+            })
+            .collect::<Vec<_>>();
+        threads.into_iter().flat_map(|thread| thread.join().unwrap()).collect::<Vec<_>>()
+    });
+    indexed_files.sort_by_key(|file| file.file_id);
+
+    let mut remapped_ids = FxHashMap::default();
+    let mut published_tokens = Vec::new();
+    for file in &mut indexed_files {
+        for (_, token_id) in &mut file.tokens {
+            let published_id = *remapped_ids.entry(*token_id).or_insert_with(|| {
+                let mut token = concurrent_tokens
+                    .remove(*token_id)
+                    .expect("every construction token must be published exactly once");
+                token.references.sort_by_key(|reference| {
+                    (
+                        reference.range.file_id,
+                        reference.range.range.start(),
+                        reference.range.range.end(),
+                        reference.is_definition,
+                    )
+                });
+                let published_id = TokenId(published_tokens.len());
+                published_tokens.push(token);
+                published_id
+            });
+            *token_id = published_id;
+        }
+    }
+    debug_assert!(
+        concurrent_tokens.is_empty(),
+        "every construction token must be reachable from an indexed file"
+    );
+
+    StaticIndex {
+        files: indexed_files
+            .into_iter()
+            .map(|file| StaticIndexedFile {
+                file_id: file.file_id,
+                folds: Vec::new(),
+                inlay_hints: Vec::new(),
+                tokens: file.tokens,
+            })
+            .collect(),
+        tokens: TokenStore(published_tokens),
+        analysis,
+        db: &analysis.db,
+        def_map: FxHashMap::default(),
+        #[cfg(test)]
+        worker_threads: num_threads,
+    }
+}
