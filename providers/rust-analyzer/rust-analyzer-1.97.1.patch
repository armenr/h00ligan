+/// Construction-only shared storage for the exact-file parallel exporter.
+///
+/// Race-assigned IDs never escape this type. `compute_exact_file_population`
+/// deterministically remaps them into the public, vector-backed `TokenStore`
+/// after every worker has joined.
+#[derive(Default)]
+struct ConcurrentTokenStore {
+    data: DashMap<TokenId, TokenStaticData>,
+    next_id: AtomicUsize,
+}
+
+impl ConcurrentTokenStore {
+    fn insert(&self, data: TokenStaticData) -> TokenId {
+        let id = TokenId(self.next_id.fetch_add(1, Ordering::Relaxed));
+        self.data.insert(id, data);
+        id
+    }
+
+    fn get_mut(&self, id: TokenId) -> Option<RefMut<'_, TokenId, TokenStaticData>> {
+        self.data.get_mut(&id)
+    }
+
+    fn remove(&self, id: TokenId) -> Option<TokenStaticData> {
+        self.data.remove(&id).map(|(_, data)| data)
+    }
+
+    fn is_empty(&self) -> bool {
+        self.data.is_empty()
+    }
+}
