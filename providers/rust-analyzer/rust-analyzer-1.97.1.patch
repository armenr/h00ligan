+            ProcMacroDylibPath::DylibNotFound
+            | ProcMacroDylibPath::NotProcMacro
+            | ProcMacroDylibPath::NotBuilt => None,
+        }
+    }
+
     pub(crate) fn get_output(&self, idx: Package) -> Option<&BuildScriptOutput> {
