+    }
+
+    /// Return the exact proc-macro dylib Cargo admitted for one package.
+    /// The embedding provider hashes these bytes so a warm analysis host
+    /// cannot outlive the executable macro implementation it loaded.
+    pub fn h00_proc_macro_dylib_path(&self, idx: Package) -> Option<&AbsPath> {
